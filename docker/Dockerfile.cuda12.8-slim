FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04 AS cuda_runtime

FROM ubuntu:22.04

ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG no_proxy
ARG NO_PROXY

ENV DEBIAN_FRONTEND=noninteractive \
    GLM_ASR_STACK_ROOT=/opt/glm-asr-stack \
    HF_HOME=/root/.cache/huggingface \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PATH=/opt/glm-asr-stack/bin:/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/glm-asr-stack/lib:/usr/local/cuda/lib64

# Minimal CUDA runtime subset used by glm_asr_infer / force_aligner:
# cudart + cuBLAS/Lt + cuFFT. libcuda.so is mounted from the host driver by
# nvidia-container-toolkit.
RUN mkdir -p /usr/local/cuda-12.8/targets/x86_64-linux/lib \
    && ln -s /usr/local/cuda-12.8 /usr/local/cuda \
    && ln -s targets/x86_64-linux/lib /usr/local/cuda-12.8/lib64

COPY --from=cuda_runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcudart.so.12.8.90 /usr/local/cuda-12.8/targets/x86_64-linux/lib/
COPY --from=cuda_runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcublas.so.12.8.4.1 /usr/local/cuda-12.8/targets/x86_64-linux/lib/
COPY --from=cuda_runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcublasLt.so.12.8.4.1 /usr/local/cuda-12.8/targets/x86_64-linux/lib/
COPY --from=cuda_runtime /usr/local/cuda-12.8/targets/x86_64-linux/lib/libcufft.so.11.3.3.83 /usr/local/cuda-12.8/targets/x86_64-linux/lib/

RUN cd /usr/local/cuda-12.8/targets/x86_64-linux/lib \
    && ln -s libcudart.so.12.8.90 libcudart.so.12 \
    && ln -s libcudart.so.12 libcudart.so \
    && ln -s libcublas.so.12.8.4.1 libcublas.so.12 \
    && ln -s libcublas.so.12 libcublas.so \
    && ln -s libcublasLt.so.12.8.4.1 libcublasLt.so.12 \
    && ln -s libcublasLt.so.12 libcublasLt.so \
    && ln -s libcufft.so.11.3.3.83 libcufft.so.11 \
    && ln -s libcufft.so.11 libcufft.so

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates python3 python3-pip ffmpeg tini \
    && python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir \
      huggingface_hub transformers tokenizers sentencepiece \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache/pip

COPY . /opt/glm-asr-stack
WORKDIR /opt/glm-asr-stack

RUN chmod +x /opt/glm-asr-stack/bin/* \
    && mkdir -p /opt/glm-asr-stack/runtime/output /opt/glm-asr-stack/runtime/work_dir \
    && rm -rf /opt/glm-asr-stack/runtime/output/* \
      /opt/glm-asr-stack/runtime/work_dir/* \
      /opt/glm-asr-stack/runtime/tasks/* \
      /opt/glm-asr-stack/runtime/live_sessions/* \
    && find /opt/glm-asr-stack -type d -name __pycache__ -prune -exec rm -rf {} +

ENTRYPOINT ["/usr/bin/tini", "--", "glm-asr"]
CMD ["help"]
